AI_PROVIDER=yunwu
YUNWU_API_KEY=sk-your-yunwu-key-here
YUNWU_BASE_URL=https://yunwu.ai/v1
YUNWU_MODEL=gpt-5.6-luna
AI_EFFORT=high
AI_REQUESTS_PER_IP_PER_HOUR=6
AI_REQUESTS_GLOBAL_PER_DAY=80
AI_MAX_TOKENS=8000
MAX_STORED_VALUE_BYTES=1000000
DATA_FILE=./data/storage.json
PORT=3000
HOST=0.0.0.0

# Meta Muse Spark 1.1 (requires a Meta Model API key, not a Yunwu key):
# AI_PROVIDER=meta
# META_API_KEY=your-meta-model-api-key
# META_BASE_URL=https://api.meta.ai/v1
# META_MODEL=muse-spark-1.1

# Optional Anthropic fallback:
# AI_PROVIDER=anthropic
# ANTHROPIC_API_KEY=sk-ant-your-key-here
# ANTHROPIC_MODEL=claude-sonnet-5
# ANTHROPIC_VERSION=2023-06-01
